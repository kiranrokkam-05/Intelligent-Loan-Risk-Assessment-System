# Comma-separated origins allowed to call the API from a separate web host.
ALLOWED_ORIGINS=https://risklens.example.com
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=32768
HOST=0.0.0.0
PORT=8000
# Use development for local work. Production startup fails closed on missing controls.
ENVIRONMENT=development
DEBUG=false
AUTH_USERNAME=admin@risklens.local
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('replace-me'))"
AUTH_PASSWORD_HASH=
# Use a long random value shared by all application workers.
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
# Set only for local development when model.joblib is intentionally absent.
ALLOW_MODEL_TRAINING=false
MODEL_VERSION=1.0.0
# Optional JSON audit log destination. Audit records never contain raw request fields.
AUDIT_LOG_PATH=
